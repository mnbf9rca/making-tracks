{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.making-tracks.app/pack-descriptor/1",
  "title": "PackDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "min_reader_version", "region", "publish_version", "generated_at", "objects"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "min_reader_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "region": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
    "publish_version": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
    "generated_at": {"type": "string", "maxLength": 64, "pattern": "^[0-9TZ:._+-]+$"},
    "objects": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "bytes", "schema_version", "optional"],
        "properties": {
          "kind": {"type": "string", "enum": ["basemap_cell", "basemap_midzoom", "description_index", "image_index", "image_thumb", "search_index"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 3221225472},
          "schema_version": {"type": "integer", "minimum": 1, "maximum": 100},
          "optional": {"type": "boolean"}
        }
      }
    }
  }
}
