{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.making-tracks.app/region-index/3",
  "title": "RegionIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "min_reader_version", "generated_at", "regions"],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "min_reader_version": {"type": "integer", "minimum": 1, "maximum": 999},
    "generated_at": {"type": "string", "format": "date-time", "maxLength": 32},
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "parent",
          "bbox",
          "search_compact",
          "basemap_bytes",
          "tile_count",
          "bytes_without_thumbs",
          "bytes_with_thumbs"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 129},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200d\\u2028\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff]*$"},
          "parent": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 129}
            ]
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {"type": "number", "minimum": -180, "maximum": 180},
              {"type": "number", "minimum": -90, "maximum": 90},
              {"type": "number", "minimum": -180, "maximum": 180},
              {"type": "number", "minimum": -90, "maximum": 90}
            ]
          },
          "search_compact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes", "schema_version"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+/search/compact\\.json$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 0, "maximum": 3221225472},
              "schema_version": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          },
          "basemap_bytes": {"type": "integer", "minimum": 0, "maximum": 3221225472},
          "tile_count": {"type": "integer", "minimum": 0, "maximum": 1048576},
          "bytes_without_thumbs": {"type": "integer", "minimum": 0, "maximum": 3221225472},
          "bytes_with_thumbs": {"type": "integer", "minimum": 0, "maximum": 8589934592}
        }
      }
    }
  }
}
