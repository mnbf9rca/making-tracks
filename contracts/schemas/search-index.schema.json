{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.making-tracks.app/search-index/1",
  "title": "SearchIndex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "min_reader_version",
    "region",
    "publish_version",
    "generated_at",
    "index_kind",
    "shard_key",
    "entries"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "min_reader_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "region": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64},
    "publish_version": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
    "generated_at": {"type": "string", "format": "date-time", "maxLength": 32},
    "index_kind": {"type": "string", "enum": ["full", "compact"]},
    "shard_key": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_]+$"}
      ]
    },
    "entries": {
      "type": "array",
      "maxItems": 700000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "place_id",
          "name",
          "alt_names",
          "tokens",
          "lat",
          "lon",
          "tier",
          "category"
        ],
        "properties": {
          "kind": {"type": "string", "enum": ["place", "zone"]},
          "place_id": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^mt1_[0-9ABCDEFGHJKMNPQRSTVWXYZ]{26}$"}
            ]
          },
          "name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200d\\u2028\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff]*$"},
          "alt_names": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200d\\u2028\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff]*$"}
          },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\s\\u200b\\u200c\\u200d\\u2028\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff]*$"}
          },
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180},
          "tier": {"type": "integer", "minimum": 1, "maximum": 4},
          "category": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200d\\u2028\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff]*$"}
        }
      }
    }
  }
}
