{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.making-tracks.app/current-catalog/1",
  "title": "CurrentCatalog",
  "description": "Shared catalog pointer from region id to currently visible publish version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publish_versions"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "publish_versions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1024,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$",
        "maxLength": 129
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]{8}T[0-9]{6}Z$"
      }
    }
  }
}
